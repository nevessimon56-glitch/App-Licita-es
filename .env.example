# Chave da API Google Gemini (obrigatória)
GEMINI_API_KEY=AIza...

# Proteção por senha (opcional — se definida, bloqueia o app e as APIs)
SITE_PASSWORD=sua-senha-secreta

# Segredo para assinar o cookie de sessão (recomendado em produção)
# Se omitido, usa SITE_PASSWORD como fallback
# AUTH_SECRET=uma-string-longa-e-aleatoria

# Modelo para ANÁLISE — padrão: gemini-2.5-flash (melhor qualidade)
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# Modelo rápido (opcional, se quiser priorizar velocidade):
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash-lite

# Modelo para CHAT — padrão: gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Atalho: define os dois (opcional, sobrescreve os acima se único)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Rode as migrations na ordem — ver supabase/SUPABASE_SETUP.md
# https://github.com/nevessimon56-glitch/App-Licita-es/blob/main/supabase/SUPABASE_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# false = esconde "Criar conta" no login (recomendado em produção)
# NEXT_PUBLIC_ALLOW_REGISTRATION=false

# Chave service role (somente servidor — painel admin lê todos os usuários)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Senha do painel administrativo (separada do login de usuário)
ADMIN_PASSWORD=sua-senha-admin-secreta
# ADMIN_AUTH_SECRET=opcional-segredo-para-cookie-admin
